PORT=5000
NODE_ENV=development
API_PREFIX=/api
DATABASE_URL="postgresql://tinhit_user:123456@localhost:5432/tinhit_tech_store?schema=public"

# JWT Config
JWT_SECRET=
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# SMTP Email Config (Leave empty to use mock/console logger in development)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="TinhIT Tech Store" <no-reply@tinhit.vn>

# Cloudinary Config
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=tinhit-tech-store
